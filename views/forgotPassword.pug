extends base

block content 
    main.main
        div.login-form
            h2.heading-secondary.ma-bt-lg Enter your email to get password reset link
            form.form.form--forgot-password
                div.form__group
                    label.form__label(for='email') Email address
                    input#email.form__input(type='email', placeholder='you@example.com', required)
                div.form__group.btn-group
                    button.btn.btn--green.form-btn Send
                    
                